T = table(Spans', mtoms'/1e3, fuels'/1e3, oems'/1e3, areas', ARs', ...
          'VariableNames', {'Span_m','MTOM_t','BlockFuel_t','OEM_t','WingArea_m2','AspectRatio'});
writetable(T, 'Boxwing_TradeStudy.csv');
